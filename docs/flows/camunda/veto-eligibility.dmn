<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="definitions_veto_eligibility" name="Veto có hợp lệ?" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="veto_eligibility" name="Veto có hợp lệ?">
    <decisionTable id="decisionTable_veto_eligibility" hitPolicy="FIRST">
      <input id="input_ageHours" label="Số giờ đã trôi từ lúc tạo case">
        <inputExpression id="inputExpression_ageHours" typeRef="number">
          <text>ageHours</text>
        </inputExpression>
      </input>
      <output id="output_allowed" label="Được veto" name="allowed" typeRef="boolean" />
      <output id="output_reason" label="Lý do" name="reason" typeRef="string" />
      <rule id="rule_too_late">
        <inputEntry id="inputEntry_rule_too_late"><text><![CDATA[> 48]]></text></inputEntry>
        <outputEntry id="outputEntry_rule_too_late_1"><text>false</text></outputEntry>
        <outputEntry id="outputEntry_rule_too_late_2"><text>"Quá 48 giờ kể từ lúc tạo case"</text></outputEntry>
      </rule>
      <rule id="rule_within_window">
        <inputEntry id="inputEntry_rule_within_window"><text><![CDATA[<= 48]]></text></inputEntry>
        <outputEntry id="outputEntry_rule_within_window_1"><text>true</text></outputEntry>
        <outputEntry id="outputEntry_rule_within_window_2"><text>""</text></outputEntry>
      </rule>
      <rule id="rule_unknown">
        <inputEntry id="inputEntry_rule_unknown"><text>-</text></inputEntry>
        <outputEntry id="outputEntry_rule_unknown_1"><text>false</text></outputEntry>
        <outputEntry id="outputEntry_rule_unknown_2"><text>"Không xác định được thời gian tạo"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
