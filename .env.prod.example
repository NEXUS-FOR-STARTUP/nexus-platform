# =============================================================================
# Nexus Platform — Production Environment
# Copy to .env and fill all values before deploying.
# =============================================================================

# -------------------------------------------------------------------
# Domain — used by Traefik routing and BETTER_AUTH_URL
# -------------------------------------------------------------------
DOMAIN=nexus-platform.com

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-32-chars-min
POSTGRES_DB=nexus_platform

# Read-only DB URL for safe query operations (optional)
READONLY_DATABASE_URL=postgresql://readonly:password@host:5432/db

# -------------------------------------------------------------------
# Better Auth
# -------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=https://${DOMAIN}

# -------------------------------------------------------------------
# Google OAuth
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# -------------------------------------------------------------------
# Cloudinary (payment proof uploads)
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://${CLOUDINARY_API_KEY}:${CLOUDINARY_API_SECRET}@${CLOUDINARY_CLOUD_NAME}

# -------------------------------------------------------------------
# AI — Gemini
# -------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_LLM=gemini-3.1-flash-lite
# @ai-sdk/google reads this var
GOOGLE_GENERATIVE_AI_API_KEY=${GEMINI_API_KEY}

# Team-fit evaluation model
AI_TEAM_FIT_MODEL=gemini-2.0-flash

# -------------------------------------------------------------------
# AI — OpenAI-compatible Fallback (V98)
# -------------------------------------------------------------------
V98_BASE_URL=https://v98store.com/v1
V98_API_KEY=your-v98-api-key
OPENAI_MODEL_LLM=gpt-5.4

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------
LOG_LEVEL=info
SERVICE_NAME=nexus-api
ENABLE_LOKI=false
LOKI_URL=
LOKI_USER=
LOKI_PASSWORD=

# -------------------------------------------------------------------
# Bank Transfer Info (displayed on payment page)
# -------------------------------------------------------------------
BANK_SHORT_CODE=BIDV
BANK_NAME="BIDV (Ngân hàng TMCP Đầu tư và Phát triển Việt Nam)"
BANK_ACCOUNT_NUMBER=your-bank-account
BANK_ACCOUNT_NAME="NEXUS PLATFORM"

# -------------------------------------------------------------------
# SePay Payment Gateway
# -------------------------------------------------------------------
SEPAY_API_TOKEN=your-sepay-token
SEPAY_WEBHOOK_API_KEY=your-webhook-secret

# -------------------------------------------------------------------
# Notifications (all OPTIONAL — thiếu key → kênh disabled + log warning, không crash)
# -------------------------------------------------------------------
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL="Nexus Platform <noreply@nexusforstartup.site>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_SUPPORTER_CHAT_ID=
NOTIFICATIONS_ENABLED=true
